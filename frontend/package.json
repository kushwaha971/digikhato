{
  "name": "daily-collection-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:docker": "playwright test -c playwright.docker.config.ts",
    "test:e2e:docker:headed": "playwright test -c playwright.docker.config.ts --headed --workers=1",
    "test:e2e:report": "playwright show-report playwright-report",
    "dev:e2e": "next dev -p 3050",
    "test:jwl": "E2E_BASE_URL=http://localhost:3050 playwright test -c playwright.jwl.config.ts",
    "test:jwl:headed": "HEADED=true E2E_BASE_URL=http://localhost:3050 playwright test -c playwright.jwl.config.ts --headed",
    "test:jwl:ui": "E2E_BASE_URL=http://localhost:3050 playwright test -c playwright.jwl.config.ts --ui",
    "test:jwl:debug": "E2E_BASE_URL=http://localhost:3050 playwright test -c playwright.jwl.config.ts --debug",
    "test:jwl:slow": "HEADED=true SLOWMO=600 E2E_BASE_URL=http://localhost:3050 playwright test -c playwright.jwl.config.ts --headed",
    "test:jwl:smoke": "E2E_BASE_URL=http://localhost:3050 playwright test -c playwright.jwl.config.ts --grep @smoke",
    "test:jwl:smoke:headed": "HEADED=true E2E_BASE_URL=http://localhost:3050 playwright test -c playwright.jwl.config.ts --headed --grep @smoke",
    "test:jwl:api": "E2E_BASE_URL=http://localhost:3050 playwright test -c playwright.jwl.config.ts --grep @api",
    "test:jwl:billing": "E2E_BASE_URL=http://localhost:3050 playwright test -c playwright.jwl.config.ts --grep @billing",
    "test:jwl:report": "playwright show-report playwright-report/jwl",
    "test:jwl:tablet": "E2E_BASE_URL=http://localhost:3050 playwright test -c playwright.jwl.config.ts --project=tablet-jwl",
    "test:jwl:tablet:headed": "HEADED=true E2E_BASE_URL=http://localhost:3050 playwright test -c playwright.jwl.config.ts --headed --project=tablet-jwl"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "formik": "^2.4.9",
    "next": "14.2.15",
    "next-pwa": "^5.6.0",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "^9.1.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
